# Defines additional platforms needed for the build.

platform(
    name = "windows_x86_64_mingw",
    constraint_values = [
        "@bazel_tools//tools/cpp:mingw",
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

# Execution platform used to build with clang-cl on Windows arm64; see the
# `windows_arm64_clang_cl` config in `.bazelrc`.
platform(
    name = "windows_arm64_clang_cl",
    constraint_values = [
        "@bazel_tools//tools/cpp:clang-cl",
        "@platforms//os:windows",
        "@platforms//cpu:arm64",
    ],
)
