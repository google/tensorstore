# Description:
#   AWS CheckSums
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

licenses(["notice"])  # Apache 2.0

exports_files(["LICENSE"])

cc_library(
    name = "aws_checksums",
    srcs = glob([
        "source/*.c",
        "source/generic/*.c",
    ]) + select({
        "@platforms//cpu:x86_64": glob([
            "source/intel/*.c",
            "source/intel/intrin/*.c",
        ]),
        "@platforms//cpu:arm64": glob(["source/arm/*.c"]),
        "//conditions:default": [],
    }) + select({
        "//conditions:default": [],
        ":use_x86_gcc": glob(["source/intel/asm/*.c"]),
    }),
    hdrs = glob([
        "include/aws/checksums/*.h",
        "include/aws/checksums/private/*.h",
    ]),
    copts = select({
        "//conditions:default": [],
        ":use_x86_msvc": [
            "/arch:AVX2",
            "/arch:AVX512",
        ],
    }) + select({
        "//conditions:default": [],
        ":use_x86_gcc": [
            "-mavx",
            "-mpclmul",
            "-msse4.2",
            "-mavx2",
            "-mavx512f",
            "-mvpclmulqdq",
        ],
    }) + select({
        "//conditions:default": [],
        ":use_arm64_msvc": ["/arch:armv8.1"],
    }) + select({
        "//conditions:default": [],
        ":use_arm64_gcc": [
            "-march=armv8-a+crc+crypto",
            "-mtune=neoverse-v1",
        ],
    }),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@aws_c_common",
    ],
)

# Constraint that indicates whether gcc-style flags should be used.
alias(
    name = "use_x86_gcc",
    actual = select({
        "@rules_cc//cc/compiler:msvc-cl": "@platforms//:incompatible",

        # Otherwise condition on x86_64.
        "//conditions:default": "@platforms//cpu:x86_64",
    }),
)

alias(
    name = "use_arm64_gcc",
    actual = select({
        "@rules_cc//cc/compiler:msvc-cl": "@platforms//:incompatible",

        # Otherwise condition on arm64.
        "//conditions:default": "@platforms//cpu:arm64",
    }),
)

alias(
    name = "use_x86_msvc",
    actual = select({
        "@rules_cc//cc/compiler:msvc-cl": "@platforms//cpu:x86_64",
        "//conditions:default": "@platforms//:incompatible",
    }),
)

alias(
    name = "use_arm64_msvc",
    actual = select({
        "@rules_cc//cc/compiler:msvc-cl": "@platforms//cpu:arm64",
        "//conditions:default": "@platforms//:incompatible",
    }),
)
